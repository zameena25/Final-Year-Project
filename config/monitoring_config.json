{
  "monitoring_paths": [
    "."
  ],
  "ignore_folder": [
    ".next",
    "node_modules",
    "__pycache__",
    ".git",
    "venv",
    "env"
  ],
  "suspicious_event_threshold": 15,
  "suspicious_time_window": 5,
  "buffer_size": 8,
  "log_file": "logs/events.jsonl",
  "alert_log_file": "logs/alerts.jsonl"
}